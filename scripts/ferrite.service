[Unit]
# systemd *user* unit — installed verbatim by scripts/install.sh (`make
# install`). No substitution: %h is systemd's own expansion for the user's
# home directory, so the same file works for any user on any box. The
# system-wide variant for a real deployment is scripts/isdbd.service.
#
# A user unit is the right shape here: the tuner and the B-CAS reader are
# reached through the invoking user's permissions (pcscd's polkit rule is
# per-user), so running as root would need a second set of rules for no
# gain. `loginctl enable-linger <user>` makes it start at boot rather than
# at login.
Description=ferrite ISDB-T TV daemon
Documentation=https://github.com/DuckFeather10086/ferrite
After=network-online.target

[Service]
Type=simple
# Nothing here points into a build tree, and that is the point. The daemon,
# the three programs it spawns and its config all live under the install
# prefix; the checkout can be cleaned, moved or deleted without the
# television noticing. It used to run as `@DIR@/isdbd` out of the checkout
# with `./target/release/dvb-rs` in its config, which made `cargo clean` the
# command that stops the box tuning — and it did, for three days.
#
# WorkingDirectory is the data root purely as a backstop: every path the
# daemon uses is absolute in the config, so nothing depends on this — but a
# relative one that slipped in would land on the data, not on /.
WorkingDirectory=%h/.local/share/ferrite
ExecStart=%h/.local/lib/ferrite/isdbd -config %h/.config/ferrite/isdbd.toml
Restart=on-failure
RestartSec=5
# Shutdown finalizes in-flight recordings before the store closes
# (StopAllAndWait 5s, then the HTTP server 5s). Give it room, or a row
# stays stuck in state 'recording'.
TimeoutStopSec=20
# A tmpfs for live HLS. systemd creates the directory and exports
# $RUNTIME_DIRECTORY pointing at it (/run/user/<uid>/ferrite for a user
# unit), which is what `hls_root = "$RUNTIME_DIRECTORY/hls"` in isdbd.toml
# resolves to — so no uid is written down anywhere. Live segments are a
# rolling write-and-delete of ~65 GB a day at 6 Mbit/s, and having that
# share a disk with a recording's sequential write helps neither.
#
# There is no per-unit size cap to set here: `RuntimeDirectorySize=` is a
# *logind* setting that sizes the whole of /run/user/<uid> (default 10% of
# RAM), not a unit directive — systemd 255 parses it in a unit only to log
# "Unknown key name" and carry on. So the bound is that tmpfs, and lowering
# it means logind.conf, for every service of this user at once.
#
# Which is acceptable because the usage is bounded by construction rather
# than by the filesystem: `-hls_flags delete_segments` with
# `-hls_list_size 12` keeps thirteen 1s segments — about 10 MB per channel
# per quality — and the idle janitor closes a session nobody has touched
# for 60s. Measured with one 720p session running: 4.3 MB.
RuntimeDirectory=ferrite
# pcscd is socket-activated system-wide; b25-rs connecting to the reader
# starts it. Nothing to declare from a user unit.

[Install]
WantedBy=default.target
